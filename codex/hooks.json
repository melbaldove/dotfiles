{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.dotfiles/claude/hooks/no-code-comments\"",
            "timeout": 10,
            "statusMessage": "Checking for new code comments"
          }
        ]
      }
    ]
  }
}
