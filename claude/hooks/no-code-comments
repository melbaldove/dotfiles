#!/usr/bin/env python3
"""PreToolUse hook: agents may not add code comments.

Works for Claude Code (Edit, Write, MultiEdit) and Codex (apply_patch).
Reads the hook JSON on stdin. Exits 2 with a reason on stderr when an edit
adds a comment line that the file did not already have; both tools treat
exit 2 as "block this tool call".

Allowed: comments that already exist (moved or re-indented), tool directives
(lint and type-checker pragmas, shebangs, build tags), and prose files.
Keep this file identical to sphere-ai-workspace/.claude/hooks/no-code-comments.
"""
import json
import os
import re
import sys

SLASH = {"js", "jsx", "ts", "tsx", "mjs", "cjs", "mts", "cts", "go", "rs", "swift",
         "kt", "kts", "java", "c", "h", "cc", "cpp", "hpp", "cs", "dart", "php",
         "proto", "zig", "scala", "groovy", "gradle", "css", "scss", "less", "sol"}
HASH = {"py", "sh", "bash", "zsh", "fish", "rb", "yaml", "yml", "toml", "nix", "pl",
        "r", "tf", "hcl", "cfg", "conf", "ps1", "cmake", "mk", "just"}
DASH = {"sql", "lua", "hs", "elm", "ada"}
SEMI = {"el", "clj", "cljs", "lisp", "scm", "rkt", "asm", "ini"}
ANGLE = {"html", "htm", "xml", "vue", "svelte", "astro"}
HASH_NAMES = {"dockerfile", "makefile", "justfile", "gemfile", "rakefile", "procfile",
              "brewfile", ".envrc"}

DIRECTIVE = re.compile(
    r"^(#!|#\s*-\*-|#\s*(frozen_string_literal|encoding|syntax=|escape=|shellcheck|noqa|"
    r"type:\s*ignore|pylint:|mypy:|pyright:|ruff:|fmt:|isort:|pragma|nosec|rubocop:)|"
    r"//\s*(@ts-|eslint|prettier-ignore|biome-ignore|istanbul|c8 |go:|\+build|nolint|"
    r"swiftlint:|swift-format-ignore|deno-|@vite-ignore|webpack|SPDX-License-Identifier|"
    r"#region|#endregion|MARK:)|"
    r"/\*\s*(eslint|istanbul|c8 |webpack|@vite-ignore|prettier-ignore|biome-ignore)|"
    r"///\s*<reference|"
    r"--\s*(migrate:|sqlfluff)|"
    r"<!--\s*(prettier-ignore|markdownlint|eslint)|"
    r"#\s*(SPDX-License-Identifier))",
    re.IGNORECASE,
)


def kind(path):
    base = os.path.basename(path).lower()
    if base in HASH_NAMES or base.startswith("dockerfile"):
        return "hash"
    ext = base.rsplit(".", 1)[-1] if "." in base else ""
    for name, exts in (("slash", SLASH), ("hash", HASH), ("dash", DASH),
                       ("semi", SEMI), ("angle", ANGLE)):
        if ext in exts:
            return name
    return None


def comment_of(line, k):
    """Return the comment text on a line, or None."""
    s = line.strip()
    if not s:
        return None
    if k == "slash":
        if s.startswith(("//", "/*", "*/")) or (s.startswith("*") and not s.startswith("**")):
            return s
        m = re.search(r"\s//\s.*$|\s/\*.*\*/\s*$", line)
        return m.group(0).strip() if m else None
    if k == "hash":
        if s.startswith("#") and not s.startswith("#{"):
            return s
        m = re.search(r"\s#\s.*$", line)
        return m.group(0).strip() if m else None
    if k == "dash":
        if s.startswith("--"):
            return s
        m = re.search(r"\s--\s.*$", line)
        return m.group(0).strip() if m else None
    if k == "semi":
        return s if s.startswith(";") else None
    if k == "angle":
        return s if s.startswith("<!--") or "<!--" in s else None
    return None


def comments(text, k):
    out = []
    for line in (text or "").splitlines():
        c = comment_of(line, k)
        if c and not DIRECTIVE.search(c):
            out.append(re.sub(r"\s+", " ", c))
    return out


def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def changes_from_claude(tool, ti):
    path = ti.get("file_path") or ti.get("path") or ""
    if tool == "Write":
        return [(path, read(path), ti.get("content", ""))]
    if tool == "Edit":
        return [(path, ti.get("old_string", "") + "\n" + read(path), ti.get("new_string", ""))]
    if tool == "MultiEdit":
        old = read(path) + "\n" + "\n".join(e.get("old_string", "") for e in ti.get("edits", []))
        new = "\n".join(e.get("new_string", "") for e in ti.get("edits", []))
        return [(path, old, new)]
    return []


def changes_from_patch(patch):
    files, cur = [], None
    for line in patch.splitlines():
        m = re.match(r"^\*\*\* (Add|Update) File: (.+)$", line)
        if m:
            cur = [m.group(2).strip(), [], []]
            files.append(cur)
            continue
        if line.startswith("*** "):
            cur = None if not line.startswith("*** Move to:") else cur
            continue
        if cur is None:
            continue
        if line.startswith("+"):
            cur[2].append(line[1:])
        elif line.startswith(("-", " ")):
            cur[1].append(line[1:])
    return [(p, "\n".join(o) + "\n" + read(p), "\n".join(n)) for p, o, n in files]


def main():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return 0
    tool = data.get("tool_name", "")
    ti = data.get("tool_input") or {}
    if tool == "apply_patch" or (isinstance(ti, dict) and "*** Begin Patch" in str(ti.get("command", ""))):
        cmd = ti.get("command", "") if isinstance(ti, dict) else ""
        if isinstance(cmd, list):
            cmd = "\n".join(cmd)
        changes = changes_from_patch(cmd)
    else:
        changes = changes_from_claude(tool, ti if isinstance(ti, dict) else {})

    added = []
    for path, old, new in changes:
        k = kind(path)
        if not k:
            continue
        before = set(comments(old, k))
        for c in comments(new, k):
            if c not in before:
                added.append((path, c))
    if not added:
        return 0

    lines = "\n".join(f"  {p}: {c[:100]}" for p, c in added[:5])
    more = f"\n  ... and {len(added) - 5} more" if len(added) > 5 else ""
    sys.stderr.write(
        "Blocked: agents do not write code comments (see AGENTS.md, Code Comments).\n"
        f"New comment lines in this edit:\n{lines}{more}\n"
        "Remove them and retry. Put the reasoning in names, the commit message, the PR, "
        "an ADR, or docs/FEATURES.org. Existing comments and tool directives "
        "(eslint-disable, noqa, @ts-expect-error, shebangs) are allowed.\n"
    )
    return 2


if __name__ == "__main__":
    sys.exit(main())
